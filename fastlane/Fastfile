# Fastfile para deploy automático no TestFlight
# Este arquivo é usado pela GitHub Action para buildar e enviar o app

opt_out_usage # Desabilita analytics do Fastlane

default_platform(:ios)

platform :ios do
  desc "Build e upload para TestFlight"
  lane :beta do
    # Incrementa o build number automaticamente
    increment_build_number(
      xcodeproj: "Focca.xcodeproj"
    )
    
    # Builda o app usando xcodebuild
    # IMPORTANTE: allowProvisioningUpdates permite que o Xcode gere/atualize profiles automaticamente
    build_app(
      scheme: "Focca",
      project: "Focca.xcodeproj",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "SKHUBRDPGV" # Seu Development Team ID
        # O Fastlane detectará automaticamente os provisioning profiles
        # ou você pode especificar manualmente se necessário:
        # provisioningProfiles: {
        #   "focca.app.Focca" => "match AppStore focca.app.Focca",
        #   "focca.app.Focca.FoccaWidgetLive" => "match AppStore focca.app.Focca.FoccaWidgetLive"
        # }
      },
      # Permite que o Xcode atualize provisioning profiles automaticamente
      # Necessário para CI/CD onde não há acesso interativo ao Xcode
      # xcargs passa argumentos diretamente para o comando xcodebuild
      xcargs: "-allowProvisioningUpdates"
    )
    
    # Faz upload para TestFlight usando App Store Connect API
    # O Fastlane detecta automaticamente as variáveis de ambiente:
    # - APP_STORE_CONNECT_API_KEY_ID
    # - APP_STORE_CONNECT_API_KEY_ISSUER_ID  
    # - APP_STORE_CONNECT_API_KEY_CONTENT
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
    
    # Mensagem de sucesso
    UI.success("✅ Build enviado com sucesso para o TestFlight!")
  end
end

